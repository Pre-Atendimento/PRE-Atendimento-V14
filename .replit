Sim. Mude principalmente isso:

```toml
[agent]
stack = "nodejs"
expertMode = true
integrations = []
```

Remova esta linha porque ela força banco local:

```toml
integrations = ["javascript_database:1.0.0"]
```

E eu também removeria esta variável do `.replit`, porque parece secret exposto:

```toml
JWT_SECRET = "..."
```

Ela deve ficar em **Secrets**, não no arquivo GitHub.

Versão ajustada:

```toml
modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run dev"
waitForPort = 5000

[agent]
stack = "nodejs"
expertMode = true
integrations = []

[userenv]

[userenv.shared]
VITE_API_URL = ""
PORT = "5000"
SUPABASE_URL = "https://yikemdxcswfvmwdvykiw.supabase.co"

[userenv.development]
VITE_API_URL = "/api"

[nix]
packages = []
channel = "stable-25_05"

[[ports]]
localPort = 5000
externalPort = 5000
```
